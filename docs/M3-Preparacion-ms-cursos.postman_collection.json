              "    throw new Error('Falta ' + key + '. Ejecuta primero el login o la preparación indicada en la descripción.');",
              "  }",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('codigoPruebaJSON', JSON.stringify(pm.collectionVariables.get('codigoPrueba') || ''));",
              "pm.variables.set('semestreJSON', JSON.stringify(pm.collectionVariables.get('semestre') || ''));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Eliminar curso",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{cursosUrl}}/cursos/{{cursoId}}",
        "description": "Ejecutar después de 04 o 05. Elimina únicamente el curso de prueba capturado en cursoId. Conserva el ID eliminado para 08 y vacía cursoId al recibir 204."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of [\"cursoId\",\"codigoPrueba\"]) {",
              "  if (!pm.collectionVariables.get(key)) {",
              "    pm.execution.setNextRequest(null);",
              "    pm.execution.skipRequest();",
              "    throw new Error('Falta ' + key + '. Ejecuta primero el login o la preparación indicada en la descripción.');",
              "  }",
              "}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of [\"tokenAdmin\"]) {",
              "  if (!pm.collectionVariables.get(key)) {",
              "    pm.execution.setNextRequest(null);",
              "    pm.execution.skipRequest();",
              "    throw new Error('Falta ' + key + '. Ejecuta primero el login o la preparación indicada en la descripción.');",
              "  }",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
              "if (pm.response.code === 204) {",
              "  pm.collectionVariables.set('cursoEliminadoId', pm.collectionVariables.get('cursoId'));",
              "  pm.collectionVariables.unset('cursoId');",
              "  pm.variables.set('cursoId', '');",
              "}"
            ]
          }
        }
      ]
    },
