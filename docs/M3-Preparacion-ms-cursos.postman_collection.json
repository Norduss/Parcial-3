    {
      "name": "11 - Login estudiante",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{usuariosUrl}}/usuarios/login",
        "description": "Completar estudianteEmail y estudiantePassword en las variables de esta colección con una cuenta activa de rol estudiante. Guarda tokenEstudiante automáticamente.",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": {{emailJSON}}, \"password\": {{passwordJSON}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('tokenEstudiante');",
              "pm.variables.set('tokenEstudiante', '');",
              "const email = pm.collectionVariables.get('estudianteEmail');",
              "const password = pm.collectionVariables.get('estudiantePassword');",
              "if (!email || !password) {",
              "  pm.execution.setNextRequest(null);",
              "  pm.execution.skipRequest();",
              "  throw new Error('Completa estudianteEmail y estudiantePassword en las variables de la colección.');",
              "}",
              "pm.variables.set('emailJSON', JSON.stringify(email));",
              "pm.variables.set('passwordJSON', JSON.stringify(password));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "let data;",
              "try { data = pm.response.json(); } catch (_) {}",
              "const valido = pm.response.code === 200 && data?.usuario?.rol === 'estudiante' && typeof data?.token === 'string' && data.token.split('.').length === 3;",
              "pm.test('Token JWT y rol estudiante', () => pm.expect(valido).to.equal(true));",
              "if (valido) {",
              "  pm.collectionVariables.set('tokenEstudiante', data.token);",
              "  pm.variables.set('tokenEstudiante', data.token);",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Consultar cursos como estudiante",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{cursosUrl}}/cursos",
        "description": "Ejecutar después de 11. Comprueba la lectura permitida al estudiante.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenEstudiante}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of [\"tokenEstudiante\"]) {",
              "  if (!pm.collectionVariables.get(key)) {",
              "    pm.execution.setNextRequest(null);",
              "    pm.execution.skipRequest();",
              "    throw new Error('Falta ' + key + '. Ejecuta primero el login o la preparación indicada en la descripción.');",
              "  }",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
