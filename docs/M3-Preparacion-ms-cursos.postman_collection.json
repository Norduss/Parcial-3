{
  "info": {
    "name": "M3 - Preparación - ms-cursos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección manual de preparación M3. Completar las contraseñas en Postman. Enviar 01 y copiar token de la respuesta a tokenAdmin. Enviar 02 para listar. Crear un curso con 04 y copiar su id a cursoId para consultar con 03, actualizar con 05 y eliminar con 06. Mantener ese ID para el 404 de 08. Utilizar únicamente el ID del curso creado en 04 para PUT y DELETE. Enviar 11 y copiar token a tokenEstudiante para 12 y 13. Cada solicitud describe el código HTTP esperado. Las variables se completan manualmente. Los datos iniciales permanecen como referencias de lectura y duplicado. Las contraseñas y los JWT están vacíos en el archivo compartido."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenAdmin}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "usuariosUrl",
      "value": "http://127.0.0.1:3001",
      "type": "string"
    },
    {
      "key": "cursosUrl",
      "value": "http://127.0.0.1:3011",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@empresa.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "estudianteEmail",
      "value": "estudiante.parcial@examen.com",
      "type": "string"
    },
    {
      "key": "estudiantePassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAdmin",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenEstudiante",
      "value": "",
      "type": "string"
    },
    {
      "key": "cursoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "codigoPrueba",
      "value": "M3-PRUEBA-001",
      "type": "string"
    },
    {
      "key": "codigoDuplicado",
      "value": "RSM101",
      "type": "string"
    },
    {
      "key": "semestre",
      "value": "2026-2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Login administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{usuariosUrl}}/usuarios/login",
        "description": "HTTP esperado 200. Completar adminPassword localmente y enviar. Copiar el campo token de la respuesta a la variable tokenAdmin.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 - Listar cursos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{cursosUrl}}/cursos",
        "description": "HTTP esperado 200. Enviar después del login administrador. Permite revisar los cursos existentes y sus códigos."
      }
    },
    {
      "name": "03 - Consultar curso por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{cursosUrl}}/cursos/{{cursoId}}",
        "description": "HTTP esperado 200. Crear primero un curso con 04 y copiar el id recibido a cursoId. Después enviar esta consulta."
      }
    },
    {
      "name": "04 - Crear curso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{cursosUrl}}/cursos",
        "description": "HTTP esperado 201. Enviar con el token administrador. Copiar el id devuelto a cursoId. Usar un codigoPrueba disponible. Valor inicial M3-PRUEBA-001.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"{{codigoPrueba}}\",\n  \"nombre\": \"Curso de prueba M3\",\n  \"creditos\": 3,\n  \"cupo\": 30,\n  \"semestre\": \"{{semestre}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 - Actualizar curso",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{cursosUrl}}/cursos/{{cursoId}}",
        "description": "HTTP esperado 200. Actualizar únicamente el curso creado en 04. Completar cursoId con su ID y conservar codigoPrueba.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"{{codigoPrueba}}\",\n  \"nombre\": \"Curso de prueba M3 actualizado\",\n  \"creditos\": 4,\n  \"cupo\": 25,\n  \"semestre\": \"{{semestre}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 - Eliminar curso",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{cursosUrl}}/cursos/{{cursoId}}",
        "description": "HTTP esperado 204. Eliminar únicamente el curso creado en 04. Completar cursoId con su ID. Conservar ese mismo valor para 08."
      }
    },
    {
      "name": "07 - Datos inválidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{cursosUrl}}/cursos",
        "description": "HTTP esperado 400. Enviar con el token administrador. El cuerpo contiene datos inválidos según el modelo de Cursos.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"\",\n  \"nombre\": \"\",\n  \"creditos\": 0,\n  \"cupo\": 0,\n  \"semestre\": \"2026-3\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 - Curso inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{cursosUrl}}/cursos/{{cursoId}}",
        "description": "HTTP esperado 404. Enviar después de eliminar con 06. cursoId debe conservar el ID del curso eliminado."
      }
    },
    {
      "name": "09 - Código duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{cursosUrl}}/cursos",
        "description": "HTTP esperado 409. Enviar con el token administrador. codigoDuplicado debe coincidir con un código existente. El valor inicial RSM101 pertenece al esquema inicial.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"{{codigoDuplicado}}\",\n  \"nombre\": \"Intento de código duplicado\",\n  \"creditos\": 3,\n  \"cupo\": 30,\n  \"semestre\": \"{{semestre}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 - Filtrar por semestre",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{cursosUrl}}/cursos?semestre={{semestre}}",
        "description": "HTTP esperado 200. Enviar con el token administrador. semestre debe tener formato AAAA-1 o AAAA-2."
      }
    },
    {
      "name": "11 - Login estudiante",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{usuariosUrl}}/usuarios/login",
        "description": "HTTP esperado 200. Completar estudiantePassword localmente y enviar. Copiar el campo token de la respuesta a tokenEstudiante.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{estudianteEmail}}\",\n  \"password\": \"{{estudiantePassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "12 - Consultar cursos como estudiante",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{cursosUrl}}/cursos",
        "description": "HTTP esperado 200. Enviar después de copiar el JWT del login estudiante a tokenEstudiante.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenEstudiante}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "13 - Crear curso como estudiante",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{cursosUrl}}/cursos",
        "description": "HTTP esperado 403. Enviar con tokenEstudiante. El cuerpo es válido y la escritura requiere administrador.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"M3-ESTUDIANTE\",\n  \"nombre\": \"Intento de estudiante\",\n  \"creditos\": 3,\n  \"cupo\": 30,\n  \"semestre\": \"{{semestre}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenEstudiante}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "14 - Consultar cursos sin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{cursosUrl}}/cursos",
        "description": "HTTP esperado 401. Enviar sin token. Esta solicitud utiliza No Auth explícito.",
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}
